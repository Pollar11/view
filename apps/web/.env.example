# ─────────────────────────────────────────────────────────────
# View — configuration
# Copy to .env.local and fill in. All values are optional; with
# none set, View runs on built-in demo data.
# ─────────────────────────────────────────────────────────────

# ---- Site gate (login wall in front of the whole app) ----------
# Users must sign in before anything renders. 3 wrong tries -> 2 min lockout.
SITE_USER=admin26
SITE_PASSWORD=admin2026&
# Secret for signing session cookies. Set a long random value in production.
AUTH_SECRET=

# ---- Admin panel (/admin) — optional, separate from the gate --------
# Min 8 chars. Unset = admin panel disabled.
ADMIN_TOKEN=

# Which content adapter to use: "mock" | "rest" | "rss"
CONTENT_PROVIDER=mock

# ---- REST adapter -------------------------------------------------
# Base URL of your site's API. View expects these endpoints:
#   GET {BASE}/sections            -> Section[]
#   GET {BASE}/videos?section=slug -> { items: Video[], nextCursor?: string }
#   GET {BASE}/videos/{id}         -> Video
# See README "Integrate your site" for the exact JSON shape.
SITE_API_URL=
# Optional bearer token / API key sent as Authorization header.
SITE_API_TOKEN=

# ---- RSS / MRSS adapter -----------------------------------------
# Comma-separated feed URLs. Each feed becomes a section.
# Media RSS <media:content>/<media:thumbnail> are used when present.
RSS_FEEDS=

# ---- Playback --------------------------------------------------
# Public site URL, used for canonical links / share URLs / CORS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seconds to cache upstream catalog responses (process cache + CDN).
CONTENT_REVALIDATE_SECONDS=60

# ---- Live events --------------------------------------------------
# REST adapter expects, when CONTENT_PROVIDER=rest:
#   GET {SITE_API_URL}/live?sport=&status=   -> LiveEvent[] | { items: LiveEvent[] }
#   GET {SITE_API_URL}/live/{idOrSlug}       -> LiveEvent
# See README "Live events" for the LiveEvent shape.
LIVE_REVALIDATE_SECONDS=15
# Sport slugs in display order. Anything not listed sorts after, alphabetically.
LIVE_SPORT_ORDER=soccer,basketball,tennis,cricket,motorsport,americanfootball
# Max live tiles streaming at once in the wall (bandwidth guard).
MAX_LIVE_PREVIEWS=6
