# ───────────────────────────────────────────────────────────────────────
#  View API — environment
#  Copy to `.env` and fill in. The API boots and serves an (empty) catalogue
#  with none of this set; run `npm run seed` for demo data.
# ───────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# ---- Database ---------------------------------------------------------
# SQLite (default, zero-config):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production) — also change `provider` in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:pass@host:5432/view?schema=public"

# ---- Auth (bcrypt + JWT access/refresh) ------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# ---- CORS: the frontends allowed to call this API --------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006,tauri://localhost

# ---- Caching --------------------------------------------------------
# In-memory response cache lifetime. Keeps latency low and shields sources.
CACHE_TTL_SECONDS=60

# ═══════════════════════════════════════════════════════════════════════
#  CONTENT SOURCES  —  the ONLY place source URLs ever live.
#  They are never sent to the frontend, never logged, never sent to any AI.
#  Three sources: exactly one has an official API; the other two are scraped.
# ═══════════════════════════════════════════════════════════════════════

# ---- Source 1 — official JSON API -----------------------------------
SOURCE_1_URL=
SOURCE_1_KIND=api
SOURCE_1_CATEGORIES=movies
SOURCE_1_NAME=
SOURCE_1_API_KEY=
SOURCE_1_API_PATH=/items
SOURCE_1_API_PAGE_SIZE=50
SOURCE_1_CRAWL_DELAY_MS=800

# ---- Source 2 — scraped HTML site ----------------------------------
SOURCE_2_URL=
SOURCE_2_KIND=scrape
SOURCE_2_CATEGORIES=sports
SOURCE_2_NAME=
SOURCE_2_LIST_PATHS=/
SOURCE_2_ITEM_PATTERN=
SOURCE_2_MAX_LIST_PAGES=4
SOURCE_2_CRAWL_DELAY_MS=1500

# ---- Source 3 — scraped HTML site ----------------------------------
SOURCE_3_URL=
SOURCE_3_KIND=scrape
SOURCE_3_CATEGORIES=documentaries
SOURCE_3_NAME=
SOURCE_3_LIST_PATHS=/
SOURCE_3_ITEM_PATTERN=
SOURCE_3_MAX_LIST_PAGES=4
SOURCE_3_CRAWL_DELAY_MS=1500

# Extra brand tokens / aliases to scrub from all text (comma-separated),
# on top of each SOURCE_n_NAME and the hostnames derived from SOURCE_n_URL.
SCRUB_TERMS=

# ---- Ingest / crawler ----------------------------------------------
INGEST_ENABLED=true
INGEST_CRON=0 */30 * * * *
INGEST_ITEM_CAP=120
INGEST_RESPECT_ROBOTS=true
INGEST_USER_AGENT=ViewAggregator/1.0 (+metadata-only; respects robots.txt)

# ---- Operator endpoints (POST /api/admin/ingest) -------------------
# Min 8 chars. Unset = admin endpoints disabled.
ADMIN_TOKEN=
