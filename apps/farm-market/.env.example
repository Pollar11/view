# Copy to .env.local and fill in for real SMS + admin access.
# Nothing here is required to run the site — every feature has a safe
# no-op / mock fallback when a value is missing.

# Admin dashboard password (protects /admin — win-back SMS campaigns, order list).
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie. Any long random string.
ADMIN_SESSION_SECRET=change-me-too

# Twilio credentials for real SMS. If any of these three are missing,
# every "send SMS" call is logged and stored as a MOCK send instead of
# actually contacting Twilio, so the site is fully usable without them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Farm's own ZIP code, used as the origin point for the delivery-distance
# and ETA estimate shown at checkout. Defaults to 94606 (845 Kennedy St,
# Oakland, CA — the farm's real address).
FARM_ORIGIN_ZIP=94606

# Optional: powers the chat assistant widget with a real Claude model
# instead of the built-in keyword-matching FAQ fallback. Without this set,
# the assistant still works — it just answers from the FAQ list directly.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5

# Optional: the canonical deployed URL, used in metadata, sitemap.xml, and
# Open Graph tags. Set this to your real domain once you have one.
NEXT_PUBLIC_SITE_URL=

# Optional: the verification code Google Search Console gives you when you
# add this site as a property there. Leave blank until you do that.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
