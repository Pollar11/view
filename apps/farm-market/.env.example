# Copy to .env.local and fill in for real SMS + admin access.
# Everything below ADMIN_SESSION_SECRET is optional — every one of those
# features has a safe no-op / mock fallback when its value is missing.

# REQUIRED in production (NODE_ENV=production, i.e. on Vercel) — without
# both of these set, /admin refuses to log in at all rather than falling
# back to a value baked into the source. In local dev, a friendly default
# is used instead so `npm run dev` works with no setup.
#
# ADMIN_PASSWORD_HASH: a salted hash of the admin dashboard password — the
#   password itself is never stored, here or anywhere else. Generate it by
#   running, on your own machine (so the plaintext never leaves it):
#     node scripts/hash-admin-password.mjs "your new admin password"
#   then paste the printed value below.
# ADMIN_SESSION_SECRET: signs the admin session cookie — any long random
#   string, e.g. `openssl rand -hex 32`.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=change-me-too

# Optional extra layer on top of the login above: a comma-separated list
# of IPs allowed to reach /admin or /api/admin/* at all (everyone else
# gets a 403 before the request reaches any admin code). Leave unset
# unless you have a stable IP to allow-list — setting this with the wrong
# IP locks even the admin out until it's corrected.
ADMIN_IP_ALLOWLIST=

# Twilio credentials for real SMS. If any of these three are missing,
# every "send SMS" call is logged and stored as a MOCK send instead of
# actually contacting Twilio, so the site is fully usable without them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Farm's own ZIP code, used as the origin point for the delivery-distance
# and ETA estimate shown at checkout. Defaults to 94606 (845 Kennedy St,
# Oakland, CA — the farm's real address).
FARM_ORIGIN_ZIP=94606

# Optional: powers the chat assistant widget with a real Claude model
# instead of the built-in keyword-matching FAQ fallback. Without this set,
# the assistant still works — it just answers from the FAQ list directly.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5

# Optional, free alternative to the above: if ANTHROPIC_API_KEY isn't set,
# the assistant tries Groq next — a free-tier API (sign up at
# console.groq.com, no card required) that hosts fast open-source models
# like Llama 3.3. Only used when ANTHROPIC_API_KEY is absent.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: the canonical deployed URL, used in metadata, sitemap.xml, and
# Open Graph tags. Set this to your real domain once you have one.
NEXT_PUBLIC_SITE_URL=

# Optional: the verification code Google Search Console gives you when you
# add this site as a property there. Leave blank until you do that.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
