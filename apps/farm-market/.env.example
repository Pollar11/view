# Copy to .env.local and fill in for real SMS + admin access.
# Nothing here is required to run the site — every feature has a safe
# no-op / mock fallback when a value is missing.

# Admin dashboard password (protects /admin — win-back SMS campaigns, order list).
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie. Any long random string.
ADMIN_SESSION_SECRET=change-me-too

# Twilio credentials for real SMS. If any of these three are missing,
# every "send SMS" call is logged and stored as a MOCK send instead of
# actually contacting Twilio, so the site is fully usable without them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Farm's own ZIP code, used as the origin point for the delivery-distance
# and ETA estimate shown at checkout.
FARM_ORIGIN_ZIP=50501
